%% Recommence : 
w_o = 2 * pi * 97.5e3;
Amin = 20; % truc standard
Amax = 3;  % ``
Dw_max = 1e3;
Dw_min = 1.5 * Dw_max;
k = Dw_max / Dw_min;

n = acosh(sqrt((10^(Amin/10) - 1)/(10^(Amax/10) - 1))) / (acosh(1 / k)); % donc ordre 4
